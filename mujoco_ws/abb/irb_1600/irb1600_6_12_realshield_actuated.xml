<mujoco model="abb_irb1600_6_12">
    <compiler angle="radian" />
    <size njmax="500" nconmax="100" />
    <option />
    <visual>
        <scale framewidth="0.01"/>
    </visual>

    <asset>
        <mesh name="base_link" file="base_link.stl" />
        <mesh name="link_1" file="link_1.stl" />
        <mesh name="link_2" file="link_2.stl" />
        <mesh name="link_3" file="link_3.stl" />
        <mesh name="link_4" file="link_4.stl" />
        <mesh name="link_5" file="link_5.stl" />
        <mesh name="link_6" file="link_6.stl" /> 
    </asset>

    <worldbody>
        <!-- Lights -->
        <light name="light0" diffuse=".5 .5 .5" pos="1.5 1.5 2" dir="-1 -1 -.5" castshadow="false" />
        <light name="light1" diffuse=".5 .5 .5" pos="-1.5 1.5 2" dir="1 -1 -.5" castshadow="false" />
        <light name="light2" diffuse=".5 .5 .5" pos="1.5 -1.5 2" dir="-1 1 -.5" castshadow="false" />
        <light name="light3" diffuse=".5 .5 .5" pos="-1.5 -1.5 2" dir="1 1 -.5" castshadow="false" />
        <geom name="floor" pos="0 0 0" size="5 5 .125" type="plane" condim="3" contype="0" conaffinity="0"/>

        <body name="base" pos="0.0 0.0 0.07847612194">
            <site name="base"/>
            <geom type="mesh" mesh="base_link"/>
            
            <body name="link_1" pos="0 0 0">
                <joint name="joint_1" type="hinge" pos="0 0 0" axis="0 0 1" limited="true" range="-3.14159 3.14159" damping="2.0" frictionloss="0.5"/>
                <geom type="mesh" mesh="link_1"/>
                
                <body name="link_2" pos="0.15 0 0.4865">
                    <joint name="joint_2" type="hinge" pos="0 0 0" axis="0 1 0" limited="true" range="-1.0995 1.9198" damping="2.0" frictionloss="0.5"/>
                    <geom type="mesh" mesh="link_2"/>
                    
                    <body name="link_3" pos="0 0 0.475">
                        <joint name="joint_3" type="hinge" pos="0 0 0" axis="0 1 0" limited="true" range="-4.1015 0.9599" damping="1.5" frictionloss="0.4"/>
                        <geom type="mesh" mesh="link_3"/>
                        
                        <body name="link_4" pos="0.3 0 0">
                            <joint name="joint_4" type="hinge" pos="0 0 0" axis="1 0 0" limited="true" range="-3.4906 3.4906" damping="1.5" frictionloss="0.4"/>
                            <geom type="mesh" mesh="link_4"/>
                            
                            <body name="link_5" pos="0.3 0 0">
                                <joint name="joint_5" type="hinge" pos="0 0 0" axis="0 1 0" limited="true" range="-2.0071 2.0071" damping="1.2" frictionloss="0.3"/>
                                <geom type="mesh" mesh="link_5"/>
                                
                                <body name="link_6" pos="0.065 0 0">
                                    <site name="ee"/>
                                    <joint name="joint_6" type="hinge" pos="0 0 0" axis="1 0 0" limited="true" range="-6.9813 6.9813" damping="1.0" frictionloss="0.2"/>
                                    <geom type="mesh" mesh="link_6"/>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <!-- Actuator Definitions with Gear Ratios and Torque Limits -->
    <actuator>
        <!-- Motor actuators, one per joint -->
        <!-- Base Rotation -->
        <motor joint="joint_1" gear="1" />
        
        <!-- Shoulder Lift -->
        <motor joint="joint_2" gear="1"/>
        
        <!-- Elbow -->
        <motor joint="joint_3" gear="1"/>
        
        <!-- Wrist Roll -->
        <motor joint="joint_4" gear="1" />
        
        <!-- Wrist Pitch -->
        <motor joint="joint_5" gear="1" />
        
        <!-- Wrist Yaw -->
    <motor joint="joint_6" gear="1" />
    </actuator>

    <keyframe>
        <key qpos='-0.5236 0 0 0 0 0'/>
    </keyframe>
</mujoco>
